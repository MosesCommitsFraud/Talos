# --- Tailscale -------------------------------------------------------------
# Admin console → Settings → Keys → "Generate auth key" (reusable: no,
# ephemeral: no). Only needed for the first login; state is kept in a volume.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=talos-llm
# TS_EXTRA_ARGS=--advertise-tags=tag:llm

# --- vLLM ------------------------------------------------------------------
# Which file in models/ to serve (without .yaml). ./run.sh <name> overrides it.
MODEL_CONFIG=qwen3.8-27b

# Long random string, e.g.  openssl rand -hex 32
# Enter the same value as API key on the endpoint in Talos.
VLLM_API_KEY=change-me

# Only for gated models (Llama, some Mistral). The three test models are open.
HF_TOKEN=

# Pinned so a restart doesn't pull a new version. vLLM >= 0.30 is needed for
# Qwen3.8-Flash-Next and GLM-5.3-Flash.
VLLM_IMAGE_TAG=v0.32.0
TAILSCALE_IMAGE_TAG=stable
